{
  "id": "memoria-openclaw",
  "name": "Memoria",
  "description": "Connects OpenClaw to a local Memoria sidecar as a first-class context engine with debug tools.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "http://127.0.0.1:18733"
      },
      "namespaceId": {
        "type": "string",
        "default": "openclaw.default"
      },
      "autoStoreAssistantTurns": {
        "type": "boolean",
        "default": false
      },
      "promptLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 4
      }
    }
  }
}
